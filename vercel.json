{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/inventory",
      "destination": "https://rejuall-md-inventory.vercel.app/inventory"
    },
    {
      "source": "/inventory/:path*",
      "destination": "https://rejuall-md-inventory.vercel.app/inventory/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
